# Chaves de API — ficam só na máquina, nunca no repositório
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rastreamento de avaliações (make mlflow; eval --track). Só endereços da máquina:
# mlflow (rede do compose), localhost ou 127.0.0.1 — o RunTracker recusa o resto.
MLFLOW_TRACKING_URI=http://mlflow:5000
